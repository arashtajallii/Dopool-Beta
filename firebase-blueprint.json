{
  "entities": {
    "UserVault": {
      "title": "UserVault",
      "description": "Authenticated runner vault storing wallet balance, starter milestones, and private profile details.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "description": "Runner full name",
          "minLength": 1,
          "maxLength": 100
        },
        "username": {
          "type": "string",
          "description": "Runner username",
          "minLength": 1,
          "maxLength": 60
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified runner email",
          "minLength": 3,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Runner mobile number",
          "minLength": 3,
          "maxLength": 30
        },
        "referralCode": {
          "type": "string",
          "description": "Unique referral code",
          "minLength": 3,
          "maxLength": 32
        },
        "lockedPoolBalance": {
          "type": "number",
          "description": "Verified POOL coin balance"
        },
        "totalKm": {
          "type": "number",
          "description": "Total verified running distance in kilometers"
        },
        "invitedFriendsCount": {
          "type": "number",
          "description": "Count of invited friends"
        },
        "streakDays": {
          "type": "number",
          "description": "Consecutive daily check-in streak"
        },
        "battleWins": {
          "type": "number",
          "description": "PvP duel wins"
        },
        "battleLosses": {
          "type": "number",
          "description": "PvP duel losses"
        },
        "battleRating": {
          "type": "number",
          "description": "PvP ELO rating"
        },
        "firstLogin": {
          "type": "boolean",
          "description": "Whether the 10-coin first login starter reward was claimed"
        },
        "firstActivity": {
          "type": "boolean",
          "description": "Whether the 10-coin first activity starter reward was claimed"
        },
        "firstInvite": {
          "type": "boolean",
          "description": "Whether the 10-coin first invite starter reward was claimed"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp"
        }
      },
      "required": [
        "ownerId",
        "fullName",
        "username",
        "email",
        "phone",
        "referralCode",
        "lockedPoolBalance",
        "totalKm",
        "invitedFriendsCount",
        "streakDays",
        "battleWins",
        "battleLosses",
        "battleRating",
        "firstLogin",
        "firstActivity",
        "firstInvite",
        "createdAt",
        "updatedAt"
      ]
    },
    "RunActivityDoc": {
      "title": "RunActivityDoc",
      "description": "Verified running activity with SHA-256 anti-cheat fingerprint.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the runner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Activity title",
          "minLength": 1,
          "maxLength": 120
        },
        "filename": {
          "type": "string",
          "description": "Source .FIT filename",
          "minLength": 1,
          "maxLength": 120
        },
        "fileHash": {
          "type": "string",
          "description": "SHA-256 anti-duplicate signature of the activity",
          "minLength": 8,
          "maxLength": 128
        },
        "distanceKm": {
          "type": "number",
          "description": "Running distance in kilometers"
        },
        "elapsedSeconds": {
          "type": "number",
          "description": "Duration in seconds"
        },
        "avgHeartRate": {
          "type": "number",
          "description": "Average heart rate in bpm"
        },
        "paceMinPerKm": {
          "type": "number",
          "description": "Average pace in minutes per kilometer"
        },
        "status": {
          "type": "string",
          "enum": ["ACCEPTED", "REJECTED"],
          "description": "Proof-of-Human verification status",
          "minLength": 8,
          "maxLength": 16
        },
        "poolReward": {
          "type": "number",
          "description": "POOL coins awarded for this run"
        },
        "source": {
          "type": "string",
          "description": "Smartwatch or app source",
          "minLength": 1,
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        }
      },
      "required": [
        "ownerId",
        "title",
        "filename",
        "fileHash",
        "distanceKm",
        "elapsedSeconds",
        "avgHeartRate",
        "paceMinPerKm",
        "status",
        "poolReward",
        "source",
        "createdAt"
      ]
    },
    "CashoutDoc": {
      "title": "CashoutDoc",
      "description": "Sheba (IBAN) cashout transaction record.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "poolAmount": {
          "type": "number",
          "description": "Redeemed POOL coins"
        },
        "tomanAmount": {
          "type": "number",
          "description": "Equivalent Toman payout amount"
        },
        "shebaNumber": {
          "type": "string",
          "description": "Iranian Sheba IBAN number",
          "minLength": 16,
          "maxLength": 34
        },
        "bankName": {
          "type": "string",
          "description": "Target bank name",
          "minLength": 2,
          "maxLength": 60
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "PROCESSED"],
          "description": "Payout status",
          "minLength": 7,
          "maxLength": 16
        },
        "trackingCode": {
          "type": "string",
          "description": "Paya tracking reference",
          "minLength": 4,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        }
      },
      "required": [
        "ownerId",
        "poolAmount",
        "tomanAmount",
        "shebaNumber",
        "bankName",
        "status",
        "trackingCode",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserVault"
      },
      "description": "Private runner vault containing wallet balance, starter milestone flags, and PII."
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": {
        "$ref": "#/entities/RunActivityDoc"
      },
      "description": "Subcollection of verified running workouts for the runner."
    },
    "/users/{userId}/cashouts/{cashoutId}": {
      "schema": {
        "$ref": "#/entities/CashoutDoc"
      },
      "description": "Subcollection of Sheba cashout requests for the runner."
    }
  }
}
